# ACI Transponder Demo Appliance environment template
# Copy this file to .env on the appliance and update values as needed.
TZ=America/Los_Angeles

NMS_MYSQL_ROOT_PASSWORD=rootpassword
NMS_MYSQL_DATABASE=auth_db
NMS_MYSQL_USER=auth_user
NMS_MYSQL_PASSWORD=auth_password

POSTGRES_USER=chirpstack
POSTGRES_PASSWORD=chirpstack
POSTGRES_DB=chirpstack

CHIRPSTACK_API_TOKEN=replace_me
CHIRPSTACK_TENANT_ID=replace_me

MIDDLEWARE_UDP_PORT=5001
GW_BRIDGE_UDP_PORT=1700