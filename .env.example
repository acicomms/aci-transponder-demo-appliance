# ACI Transponder Demo Appliance environment template
# Copy this file to .env on the appliance and update values as needed.

CUSTOMER_NAME=DemoCustomer
APPLIANCE_NAME=aci-txp-demo-001
TIMEZONE=America/Los_Angeles

# ChirpStack / PostgreSQL
POSTGRES_USER=chirpstack
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=chirpstack

# MQTT
MQTT_USERNAME=aci_demo
MQTT_PASSWORD=change_me_mqtt_password

# ACI NMS
NMS_ADMIN_USER=admin
NMS_ADMIN_PASSWORD=change_me_nms_password
NMS_PORT=3000
